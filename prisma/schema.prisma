// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================
// 1. Category Master
// =============================================
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  prefix    String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@map("categories")
}

// =============================================
// 2. Staff / Helper Master
// =============================================
model Staff {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  type      StaffType
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockOuts StockOut[]

  @@map("staff")
}

enum StaffType {
  Staff
  Helper
  Supplier
  Other
}

// =============================================
// 3. Item Master
// =============================================
model Item {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemCode     String   @unique @map("item_code") @db.VarChar(20)
  itemName     String   @map("item_name") @db.VarChar(200)
  categoryName String   @map("category") @db.VarChar(100)
  unit         String   @default("Nos") @db.VarChar(50)
  minimumStock Float      @default(5) @map("minimum_stock")
  description  String?  @db.Text
  photoUrl     String?  @map("photo_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category  Category   @relation(fields: [categoryName], references: [name])
  stockIns  StockIn[]
  stockOuts StockOut[]
  kitItems  KitItem[]

  @@map("items")
}

// =============================================
// 4. Stock In
// =============================================
model StockIn {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime @db.Date
  time       String   @db.VarChar(10)
  itemCode   String   @map("item_code") @db.VarChar(20)
  itemName   String   @map("item_name") @db.VarChar(200)
  category   String?  @db.VarChar(100)
  quantity   Float
  source     String   @default("Supplier") @db.VarChar(150)
  remarks    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)

  @@index([itemCode])
  @@index([date])
  @@map("stock_in")
}

// =============================================
// 5. Stock Out
// =============================================
model StockOut {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime @db.Date
  time        String   @db.VarChar(10)
  itemCode    String   @map("item_code") @db.VarChar(20)
  itemName    String   @map("item_name") @db.VarChar(200)
  category    String?  @db.VarChar(100)
  quantity    Float
  handoverTo  String?  @map("handover_to") @db.VarChar(150)
  staffId     String?  @map("staff_id") @db.Uuid
  purpose     String?  @db.Text
  remarks     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item  Item   @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([itemCode])
  @@index([date])
  @@map("stock_out")
}

// =============================================
// 6. Tools
// =============================================
model Tool {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolCode  String   @unique @map("tool_code") @db.VarChar(50)
  toolName  String   @map("tool_name") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs      ToolLog[]

  @@map("tools")
}

// =============================================
// 7. Tool Logs (Issuance & Returns)
// =============================================
model ToolLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolCode    String   @map("tool_code") @db.VarChar(50)
  helperName  String   @map("helper_name") @db.VarChar(150)
  issueTime   String   @map("issue_time") @db.VarChar(10)
  returnTime  String?  @map("return_time") @db.VarChar(10)
  status      String   @default("ISSUED") @db.VarChar(20) // ISSUED or RETURNED
  date        DateTime @default(now()) @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tool        Tool     @relation(fields: [toolCode], references: [toolCode])

  @@map("tool_logs")
}

// =============================================
// 8. Kit / Package Master
// =============================================
model Kit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitName     String   @unique @map("kit_name") @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kitItems    KitItem[]

  @@map("kits")
}

model KitItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitId     String   @map("kit_id") @db.Uuid
  itemCode  String   @map("item_code") @db.VarChar(20)
  quantity  Float    @default(1)
  unit      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)

  @@map("kit_items")
}

// =============================================
// 9. Users / Authentication
// =============================================
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  mobile    String   @unique @db.VarChar(15)
  password  String   @db.VarChar(255)
  role      String   @default("Store_Incharge") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// =============================================
// 10. Requisitions History
// =============================================
model Requisition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String   @db.VarChar(50) // "REGULAR" or "KIT"
  kitName         String?  @map("kit_name") @db.VarChar(200)
  kitMultiplier   Float?   @map("kit_multiplier")
  exportFormat    String   @map("export_format") @db.VarChar(20) // "PDF" or "EXCEL"
  createdAt       DateTime @default(now()) @map("created_at")

  items           RequisitionItem[]

  @@map("requisitions")
}

model RequisitionItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisitionId   String   @map("requisition_id") @db.Uuid
  itemCode        String   @map("item_code") @db.VarChar(20)
  itemName        String   @map("item_name") @db.VarChar(200)
  category        String?  @db.VarChar(100)
  currentQty      Float    @map("current_qty")
  reqQty          Float    @map("req_qty")

  requisition     Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("requisition_items")
}